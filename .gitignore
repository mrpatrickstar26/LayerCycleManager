# =====================================
# AutoCAD temporary and backup files
# =====================================

# Резервные копии AutoCAD
*.bak

# Файлы блокировки чертежей AutoCAD
*.dwl
*.dwl2

# Временные файлы
*.tmp

# Резервные файлы AutoCAD
*.sv$

# =====================================
# Local plugin settings
# =====================================

# Локальные настройки программы, которые создаются во время работы
settings/lcm_settings.cfg

# =====================================
# VSCode local settings
# =====================================

# Локальные настройки VSCode, чтобы не тащить их между компьютерами
.vscode/settings.json

# Но можно оставить общие рекомендации по расширениям, если нужно:
# .vscode/extensions.json

# =====================================
# Python cache and virtual environments
# =====================================

# Если в проекте останутся старые Python-файлы
__pycache__/
*.pyc
*.pyo

# Виртуальные окружения Python
.venv/
venv/

# =====================================
# Logs
# =====================================

*.log

# =====================================
# Optional: test drawings
# =====================================

# Если тестовые DWG большие и не нужны в репозитории, раскомментируй:
# *.dwg