# =====================================
# AutoCAD temporary and backup files
# =====================================

# Резервные копии AutoCAD
*.bak

# Файлы блокировки чертежей AutoCAD
*.dwl
*.dwl2

# Временные файлы
*.tmp

# Резервные файлы автосохранения AutoCAD
*.sv$

# =====================================
# AutoCAD interface files (CUIX)
# =====================================

# Ресурсные файлы меню, создаются при загрузке CUIX
# (включая версии для тем оформления, например lcm_light.mnr)
*.mnr

# Резервные копии CUIX, создаются при сохранении в редакторе CUI
# (форма вида lcm.cuix.bak уже покрывается маской *.bak выше)
*.bak.cuix

# =====================================
# Local plugin settings
# =====================================

# Локальные настройки программы, которые создаются во время работы
settings/lcm_settings.cfg

# =====================================
# VSCode local settings
# =====================================

# Локальные настройки VSCode, чтобы не тащить их между компьютерами
.vscode/settings.json

# =====================================
# Python cache and virtual environments
# =====================================

# Если в проекте останутся старые Python-файлы прототипа
__pycache__/
*.pyc
*.pyo

# Виртуальные окружения Python
.venv/
venv/

# =====================================
# Logs
# =====================================

*.log

# =====================================
# Optional: test drawings
# =====================================

# Если тестовые DWG большие и не нужны в репозитории, раскомментируй:
 *.dwg